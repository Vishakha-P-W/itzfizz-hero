{
  "name": "itzfizz-hero",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "NEXT_PUBLIC_BASE_PATH=/itzfizz-hero next build",
    "preview": "npx serve out",
    "start": "serve out -s -l tcp://0.0.0.0:${PORT:-3000}",
